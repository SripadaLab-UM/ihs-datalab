# Rendered by the stock nginx entrypoint (envsubst only substitutes the
# variables listed in NGINX_ENVSUBST_FILTER-matching env; see run command).
map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

server {
    listen 80 default_server;
    server_name _;
    access_log /dev/stdout;   # default combined format: no headers logged

    client_max_body_size 50m;

    location /v1/ {
        proxy_pass https://${UPSTREAM_HOST}/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host ${UPSTREAM_HOST};
        proxy_set_header Connection "";
        # Replace whatever dummy the agent sent with the real key.
        include /etc/nginx/secret/auth.conf;
        proxy_set_header X-Forwarded-For "";
        proxy_ssl_server_name on;
        proxy_ssl_name ${UPSTREAM_HOST};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        # SSE streaming
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_connect_timeout 15s;
    }

    location /mcp {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host ${MCP_HOST_HEADER};
        proxy_set_header Connection "";
        # Authorization (per-session MCP bearer) passes through untouched.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / { return 404; }
}
