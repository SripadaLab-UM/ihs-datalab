js_import filter from /etc/nginx/njs/filter.js;

server {
    listen 80 default_server;
    server_name _;

    # Whole request body must stay in memory so njs can inspect it.
    client_max_body_size 32m;
    client_body_buffer_size 32m;

    # Shared upstream settings
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${UPSTREAM_HOST};
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 3;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_connect_timeout 15s;

    location = /v1/responses {
        limit_except POST { deny all; }
        js_content filter.check;          # validates, then internalRedirect -> @umgpt_responses
    }
    location @umgpt_responses {
        proxy_pass https://${UPSTREAM_HOST};   # named location: original URI /v1/responses is kept
        proxy_set_header Host ${UPSTREAM_HOST};
        proxy_set_header Connection "";
        include /etc/nginx/secret/auth.conf;
    }
    location = /v1/models {
        limit_except GET { deny all; }
        proxy_pass https://${UPSTREAM_HOST}/v1/models;
        proxy_set_header Host ${UPSTREAM_HOST};
        proxy_set_header Connection "";
        include /etc/nginx/secret/auth.conf;
    }
    location /v1/ { return 403; }

    location /mcp {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_set_header Host ${MCP_HOST_HEADER};
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / { return 404; }
}
